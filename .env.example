# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Nasdaq: the official API key, pending as of Sept 2026. Until it is set, the system falls back
# to Nasdaq's public endpoints, with Yahoo behind them. stockdata.official_provider() is the hook.
NASDAQ_API_KEY=
NASDAQ_API_PRODUCT=

# Alpha Vantage: optional, used by the news desk for sentiment. Without it that feed is skipped.
ALPHAVANTAGE_API_KEY=

# Claude runs through the Max-plan CLI, so no ANTHROPIC_API_KEY is needed or wanted here.
# agents._env() actively strips ANTHROPIC_API_KEY and CLAUDE_CODE_* from the subprocess
# environment: an invalid key in the shell would otherwise override the Max login.
