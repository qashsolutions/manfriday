# Man Friday — environment template
# Copy to .env.local and fill in. .env.local is gitignored — real values NEVER get committed.
# Full wiring map (which value lives in Vercel vs Convex vs Railway): see vercel_var.md

# ── Convex ────────────────────────────────────────────────────────────────────
# Easiest: run `npx convex dev` once — it logs you in, creates the project, and
# writes BOTH of these into .env.local automatically. Manual: dashboard.convex.dev
# → project → Settings → URL & Deploy Key.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# ── Clerk ─────────────────────────────────────────────────────────────────────
# dashboard.clerk.com → your "manfriday" application → API Keys.
# Publishable key starts pk_test_ (later pk_live_), secret starts sk_test_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── FAL ───────────────────────────────────────────────────────────────────────
# fal.ai/dashboard → Keys → Create key. One string, format "id:secret".
# Set a spending cap in the FAL dashboard before first use.
FAL_KEY=

# ── Anthropic ────────────────────────────────────────────────────────────────
# console.anthropic.com → API Keys. Starts sk-ant-. Set a spend cap in Console.
ANTHROPIC_API_KEY=

# ── Site ──────────────────────────────────────────────────────────────────────
# Only needed if deploying somewhere other than manfriday.app (code defaults to it).
# NEXT_PUBLIC_SITE_URL=https://manfriday.app
