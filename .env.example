# Copy this file to .env (project root) and fill in your values.
# The MCP server loads .env at startup; real shell env vars take precedence.
# .env is gitignored — never commit it.

# YouTube Data API v3 key (Google Cloud Console -> Credentials -> API key).
# Enables official-API paths for metadata/search/listings/comments.
YOUTUBE_API_KEY=

# Notion internal integration token (notion.so/my-integrations)
NOTION_API_KEY=

# Set after running setup_notion_database once (video catalog for yt-catalog)
NOTION_DATABASE_ID=

# Notion page (shared with the integration) under which agent reports are saved
NOTION_PARENT_PAGE_ID=

# --- OAuth (private analytics for your own channel) ---
# These two are FILES, not env values. Defaults (no config needed):
#   OAuth client JSON  -> youtube-mcp/client_secret.json
#   token (auto-saved) -> youtube-mcp/.oauth-token.json
# Only set these if you want custom locations:
# YT_OAUTH_CLIENT_SECRETS=
# YT_OAUTH_TOKEN=
