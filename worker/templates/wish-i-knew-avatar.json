{
  "specVersion": 1,
  "slug": "wish-i-knew-avatar",
  "format": "avatar",
  "hookPattern": "wish-i-knew",
  "niches": ["build-in-public", "solo-saas"],
  "platforms": ["tiktok", "youtube"],
  "slots": [
    { "id": "hook_overlay", "type": "text", "maxChars": 60,
      "guidance": "label: things I wish I knew before <the audience's situation>, lowercase" },
    { "id": "vo_script", "type": "script", "targetSeconds": 24,
      "guidance": "three fast lessons in first person, each one sentence with a concrete detail; the third lesson naturally introduces the product as what fixed it" },
    { "id": "cta", "type": "text", "maxChars": 40, "guidance": "closing card naming the product" },
    { "id": "caption", "type": "text", "maxChars": 150, "use": "publish",
      "guidance": "lesson #3 as a one-liner, exactly 2 niche hashtags" }
  ],
  "renderPlan": {
    "kind": "avatar",
    "durationCapSeconds": 35,
    "music": { "mood": "none", "source": "licensed_library" },
    "character": { "pick": "user_default" },
    "speech": { "slotRef": "vo_script", "tts": "character_voice", "lipsync": "lazy_on_right_swipe" },
    "captions": { "from": "vo_script", "styleToken": "caption-md", "position": "center-low" },
    "overlay": { "slotRef": "hook_overlay", "styleToken": "label-sm", "position": "upper-third", "showSeconds": 4.0 },
    "endCard": { "holdSeconds": 2.5,
      "bg": { "kind": "brand_screenshot", "pick": "hero" },
      "text": { "slotRef": "cta", "styleToken": "cta-md", "position": "center" } }
  }
}
