# manfriday webapp — environment variables
# Copy to .env.local for local dev; set the same in Vercel for production.

# Supabase (public — safe in the client bundle)
NEXT_PUBLIC_SUPABASE_URL=https://jxlhvxkaetuhtmwjvlym.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_mTxxdoBvQbh7fZ1yGeO-gg__DNI_Wki

# Server-only — never expose these to the client.
# Google web OAuth client (the "Connect your YouTube channel" flow).
# In Google Cloud console, the client's Authorized redirect URIs must include:
#   <site-origin>/api/connections/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32 random bytes, base64 — encrypts YouTube refresh tokens at rest.
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Supabase secret (service-role) key — Dashboard -> Settings -> API keys.
# Required for: connections status/connect/disconnect, account delete, first-run analysis.
SUPABASE_SECRET_KEY=
